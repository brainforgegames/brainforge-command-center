{
  "name": "brainforge-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "worker:once": "node orchestrator/worker.mjs --once",
    "worker:plan": "node orchestrator/worker.mjs --once --dry-run",
    "test:rules": "firebase emulators:exec --project demo-bcc --only firestore \"node --test tests/rules.integration.mjs tests/coordination.integration.mjs tests/analytics.integration.mjs\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^15.33.0",
    "vite": "^7.0.0"
  }
}
